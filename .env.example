# Copy to .env.local. Never commit real values.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The live address. Unset = robots.txt blocks crawling on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS at /admin (docs/CMS-SETUP.md). Without DATABASE_URL the site works and the CMS is off.
# The cms_app login through the Supabase transaction pooler:
DATABASE_URL=postgres://cms_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase CA certificate (PEM, \n for line breaks):
DATABASE_CA_CERT=
CMS_SETUP_CODE=change-me-to-a-long-random-code
CRON_SECRET=change-me-too

# Optional
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# PAGESPEED_API_KEY=
# CMS_CRAWL_ORIGIN=https://automiqautomation.com
