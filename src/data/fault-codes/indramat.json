[{"code":"F207","slug":"f207","type":"Fault","name":"Switching to uninitialized operation mode","area":"Communication"},{"code":"F208","slug":"f208","type":"Fault","name":"UL: The motor type has changed","area":"Parameters / setup"},{"code":"F209","slug":"f209","type":"Fault","name":"PL: Load parameter default values","area":"Parameters / setup"},{"code":"F218","slug":"f218","type":"Fault","name":"Amplifier overtemp. shutdown","area":"Thermal","meaning":"The drive's heat sink is too hot, so it shut down to protect itself.","symptoms":"Fault after running a while or in a hot cabinet.","causes":"Cabinet ambient too high; dirty heat sink; blocked airflow; failed fan.","checks":"Check the fan; clean the heat sink; measure the cabinet temperature.","repairable":"Yes: fan replacement and cleaning are routine.","service":"Servo drive repair; cooling fan replacement"},{"code":"F219","slug":"f219","type":"Fault","name":"Motor overtemp. shutdown","area":"Thermal","meaning":"The motor's temperature has gone above its shutdown limit.","symptoms":"Fault after heavy running, or at once if the sensor circuit is open.","causes":"Motor overloaded; motor cooling poor; faulty temperature sensor or wiring.","checks":"Feel whether the motor is hot; check the temperature sensor wiring with power off.","repairable":"Yes: sensor and winding repairs on MKD and MHD motors.","service":"Servo motor repair"},{"code":"F220","slug":"f220","type":"Fault","name":"Bleeder overload shutdown","area":"Power section"},{"code":"F221","slug":"f221","type":"Fault","name":"Motor temp. surveillance defective","area":"Thermal"},{"code":"F226","slug":"f226","type":"Fault","name":"Undervoltage in power section","area":"Power section","meaning":"The DC bus voltage fell below the minimum level and the drive shut down.","symptoms":"Fault when power is switched off while enabled, or on supply dips.","causes":"Power removed before drive enable was dropped; supply disturbance; failed bus supply or capacitors.","check